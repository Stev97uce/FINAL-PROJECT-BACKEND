{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DB_HOST", "DB_PORT", "DB_USER", "DB_PASSWORD", "DB_NAME", "RABBITMQ_HOST", "JWT_SECRET_KEY"]
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["DB_HOST", "DB_PORT", "DB_USER", "DB_PASSWORD", "DB_NAME", "RABBITMQ_HOST", "JWT_SECRET_KEY"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": ["**/*.py", "**/*.go", "tests/**", "**/test_*.py", "**/*_test.go"]
    },
    "lint": {
      "outputs": [],
      "inputs": ["**/*.py", "**/*.go"]
    },
    "format": {
      "outputs": [],
      "inputs": ["**/*.py", "**/*.go"]
    },
    "docker:build": {
      "dependsOn": ["^docker:build"],
      "outputs": [],
      "cache": false
    }
  }
}
