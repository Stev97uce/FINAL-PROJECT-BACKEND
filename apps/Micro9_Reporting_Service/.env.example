# Application
APP_NAME=Reporting Service
VERSION=1.0.0
DEBUG=False
SERVICE_PORT=8008

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@postgresql:5432/reporting_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=uce_events

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=America/Guayaquil

# JWT Authentication
SECRET_KEY=Q7v1P7Rp-vglhy04pduFZ0LeHW-_z9eBqSPwEV_2Ea4
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# Microservices URLs
AUTH_SERVICE_URL=http://auth-service:8000
USER_SERVICE_URL=http://user-service:8001
PATIENT_SERVICE_URL=http://patient-service:8002
APPOINTMENT_SERVICE_URL=http://appointment-service:8003
ROOM_SERVICE_URL=http://room-service:8004
CLINICAL_SERVICE_URL=http://clinical-service:8005
SUPERVISION_SERVICE_URL=http://supervision-service:8006
NOTIFICATION_SERVICE_URL=http://notification-service:8007

# Report Generation
REPORTS_STORAGE_PATH=/app/reports
REPORTS_MAX_FILE_SIZE_MB=50
REPORTS_RETENTION_DAYS=90
DEFAULT_REPORT_FORMAT=pdf
ENABLE_CHARTS=True

# Scheduled Reports
ENABLE_SCHEDULED_REPORTS=True
SCHEDULER_TIMEZONE=America/Guayaquil

# Limits
MAX_CONCURRENT_REPORTS=5
REPORT_TIMEOUT_SECONDS=300
MAX_DATA_ROWS_PER_REPORT=10000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
