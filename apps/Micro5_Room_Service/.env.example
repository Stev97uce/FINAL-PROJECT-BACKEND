# Server
APP_NAME=Room Service
APP_VERSION=1.0.0
ENVIRONMENT=development
PORT=8004
DEBUG=true

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=room_db
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=uce_events

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256

# External Services
AUTH_SERVICE_URL=http://localhost:8000
USER_SERVICE_URL=http://localhost:8001
PATIENT_SERVICE_URL=http://localhost:8002
APPOINTMENT_SERVICE_URL=http://localhost:8003

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
