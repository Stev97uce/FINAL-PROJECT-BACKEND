							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token_estudiante}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"metric_type\": \"test_metric\",\n  \"data\": {\n    \"value\": 1\n  }\n}"
						},
						"url": {
							"raw": "http://localhost:8009/api/v1/metrics/",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8009",
							"path": ["api", "v1", "metrics", ""]
						},
						"description": "Debe retornar 403 Forbidden (estudiante no puede crear métricas)"
					},
					"response": []
				},
