					"name": "403 - Estudiante Elimina Dashboard",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_estudiante}}"
							}
						],
						"url": {
							"raw": "http://localhost:8009/api/v1/dashboards/{{dashboard_id}}",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8009",
							"path": ["api", "v1", "dashboards", "{{dashboard_id}}"]
						},
						"description": "Debe retornar 403 Forbidden (estudiante no puede eliminar)"
					},
					"response": []
				},
				{
					"name": "400 - Métrica Sin Tipo",
					"request": {
						"method": "POST",
						"header": [
