						"url": {
							"raw": "http://localhost:8009/api/v1/dashboards/",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8009",
							"path": ["api", "v1", "dashboards", ""]
						},
						"description": "Listar dashboards propios + públicos (psicólogo)"
					},
					"response": []
				},
				{
					"name": "Listar Dashboards (Estudiante)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_estudiante}}"
							}
						],
						"url": {
							"raw": "http://localhost:8009/api/v1/dashboards/",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8009",
							"path": ["api", "v1", "dashboards", ""]
						},
						"description": "Listar solo dashboards públicos (estudiante)"
					},
					"response": []
				},
				{
					"name": "Obtener Dashboard por ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_coordinador}}"
							}
						],
						"url": {
							"raw": "http://localhost:8009/api/v1/dashboards/{{dashboard_id}}",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8009",
							"path": ["api", "v1", "dashboards", "{{dashboard_id}}"]
						},
						"description": "Obtener dashboard específico por ID (reemplazar {{dashboard_id}})"
					},
					"response": []
				},
				{
					"name": "Actualizar Dashboard (Admin)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token_admin}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Dashboard Principal - Actualizado\",\n  \"description\": \"Vista general del sistema (actualizada con más widgets)\",\n  \"is_public\": true,\n  \"widgets\": [\n    {\n      \"title\": \"Estadísticas de Citas Actualizadas\",\n      \"metric_type\": \"appointment_stats\",\n      \"position\": {\n        \"x\": 0,\n        \"y\": 0,\n        \"width\": 4,\n        \"height\": 4\n      }\n    },\n    {\n      \"title\": \"Actividad de Usuarios\",\n      \"metric_type\": \"user_activity\",\n      \"position\": {\n        \"x\": 4,\n        \"y\": 0,\n        \"width\": 4,\n        \"height\": 4\n      }\n    },\n    {\n      \"title\": \"Rendimiento del Sistema\",\n      \"metric_type\": \"system_performance\",\n      \"position\": {\n        \"x\": 8,\n        \"y\": 0,\n        \"width\": 4,\n        \"height\": 4\n      }\n    },\n    {\n      \"title\": \"Sesiones Clínicas\",\n      \"metric_type\": \"session_stats\",\n      \"position\": {\n        \"x\": 0,\n        \"y\": 4,\n        \"width\": 6,\n        \"height\": 4\n      }\n    },\n    {\n      \"title\": \"Utilización de Salas\",\n      \"metric_type\": \"room_utilization\",\n      \"position\": {\n        \"x\": 6,\n        \"y\": 4,\n        \"width\": 6,\n        \"height\": 4\n      }\n    }\n  ]\n}"
						},
						"url": {
							"raw": "http://localhost:8009/api/v1/dashboards/{{dashboard_id}}",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8009",
							"path": ["api", "v1", "dashboards", "{{dashboard_id}}"]
						},
						"description": "Actualizar dashboard existente (reemplazar {{dashboard_id}})"
					},
					"response": []
				},
				{
					"name": "Eliminar Dashboard (Admin)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_admin}}"
							}
						],
						"url": {
							"raw": "http://localhost:8009/api/v1/dashboards/{{dashboard_id}}",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8009",
							"path": ["api", "v1", "dashboards", "{{dashboard_id}}"]
						},
						"description": "Eliminar dashboard (solo admin/coordinador, reemplazar {{dashboard_id}})"
					},
					"response": []
				}
			]
		},
		{
			"name": "5. Error Cases",
			"item": [
