		{
			"name": "4. Dashboards - CRUD",
			"item": [
				{
					"name": "Crear Dashboard Público (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token_admin}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Dashboard Principal - Sistema UCE\",\n  \"description\": \"Vista general del sistema con métricas clave\",\n  \"is_public\": true,\n  \"widgets\": [\n    {\n      \"title\": \"Estadísticas de Citas\",\n      \"metric_type\": \"appointment_stats\",\n      \"position\": {\n        \"x\": 0,\n        \"y\": 0,\n        \"width\": 6,\n        \"height\": 4\n      }\n    },\n    {\n      \"title\": \"Actividad de Usuarios\",\n      \"metric_type\": \"user_activity\",\n      \"position\": {\n        \"x\": 6,\n        \"y\": 0,\n        \"width\": 6,\n        \"height\": 4\n      }\n    },\n    {\n      \"title\": \"Utilización de Salas\",\n      \"metric_type\": \"room_utilization\",\n      \"position\": {\n        \"x\": 0,\n        \"y\": 4,\n        \"width\": 6,\n        \"height\": 4\n      }\n    },\n    {\n      \"title\": \"Rendimiento del Sistema\",\n      \"metric_type\": \"system_performance\",\n      \"position\": {\n        \"x\": 6,\n        \"y\": 4,\n        \"width\": 6,\n        \"height\": 4\n      }\n    }\n  ]\n}"
						},
						"url": {
							"raw": "http://localhost:8009/api/v1/dashboards/",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8009",
							"path": ["api", "v1", "dashboards", ""]
						},
						"description": "Crear dashboard público visible para todos"
					},
					"response": []
				},
				{
					"name": "Crear Dashboard Privado (Psicólogo)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token_psicologo}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Mi Dashboard Personal\",\n  \"description\": \"Dashboard privado para seguimiento de mis sesiones\",\n  \"is_public\": false,\n  \"widgets\": [\n    {\n      \"title\": \"Mis Sesiones\",\n      \"metric_type\": \"session_stats\",\n      \"position\": {\n        \"x\": 0,\n        \"y\": 0,\n        \"width\": 12,\n        \"height\": 6\n      }\n    },\n    {\n      \"title\": \"Mis Supervisiones\",\n      \"metric_type\": \"supervision_stats\",\n      \"position\": {\n        \"x\": 0,\n        \"y\": 6,\n        \"width\": 12,\n        \"height\": 4\n      }\n    }\n  ]\n}"
						},
						"url": {
							"raw": "http://localhost:8009/api/v1/dashboards/",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8009",
							"path": ["api", "v1", "dashboards", ""]
						},
						"description": "Crear dashboard privado (solo visible para el creador)"
					},
					"response": []
				},
				{
					"name": "Listar Dashboards (Psicólogo)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_psicologo}}"
