# Environment variables for Supervision Service

# Application
DEBUG=False

# Database
DATABASE_URL=postgresql://postgres:postgres@postgresql:5432/supervision_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=uce_events

# JWT
SECRET_KEY=your-secret-key-change-in-production-supervision-service-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
