{
  "name": "uce-psicologia-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de Gestión de Consultantes UCE - Backend Microservicios",
  "scripts": {
    "dev": "turbo run dev",
    "start": "turbo run start",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "docker:build": "turbo run docker:build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "clean": "turbo run clean",
    "auth:dev": "turbo run dev --filter=Micro1_Auth_Service",
    "user:dev": "turbo run dev --filter=Micro2_User_Service"
  },
  "devDependencies": {
    "turbo": "^2.7.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.8.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-usuario/uce-psicologia-backend"
  },
  "keywords": [
    "microservices",
    "fastapi",
    "go",
    "gin",
    "rabbitmq",
    "turborepo",
    "aws"
  ],
  "author": "UCE Psicología Team",
  "license": "MIT"
}
