# ============================================
# CONFIGURACIÓN DE APLICACIÓN
# ============================================

# Entorno
NODE_ENV=production

# Puerto del microservicio (cambiar según el servicio)
# Auth: 8000, User: 8001, Patient: 8002, Appointment: 8003
# Room: 8004, Clinical: 8005, Supervision: 8006, Notification: 8007
# Reporting: 8008, Analytics: 8009
PORT=8000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# SEGURIDAD
# ============================================

# JWT
JWT_SECRET=uce-psychology-secret-2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=https://qa-api.uce-psychology.com,https://api.uce-psychology.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# API GATEWAY
# ============================================
API_GATEWAY_QA=https://qa-api.uce-psychology.com
API_GATEWAY_PROD=https://api.uce-psychology.com

# ============================================
# SERVICIOS DE OBSERVABILIDAD
# ============================================

# Prometheus (acceso via SSH tunnel)
PROMETHEUS_URL=http://10.10.10.10:9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana (acceso via SSH tunnel)
GRAFANA_URL=http://10.10.10.20:3000

# Site24x7 (acceso via SSH tunnel)
SITE24X7_AGENT=10.10.10.30

# ============================================
# HEALTHCHECK
# ============================================
HEALTHCHECK_ENABLED=true
HEALTHCHECK_INTERVAL=30000
HEALTHCHECK_TIMEOUT=5000

# ============================================
# TIMEOUTS Y RETRIES
# ============================================
DB_CONNECTION_TIMEOUT=5000
DB_QUERY_TIMEOUT=10000
DB_POOL_MIN=2
DB_POOL_MAX=10

HTTP_TIMEOUT=30000
HTTP_RETRIES=3
HTTP_RETRY_DELAY=1000

# ============================================
# CACHE
# ============================================
CACHE_TTL=3600
CACHE_PREFIX=uce_psychology

